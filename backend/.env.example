# Conductor backend environment — copy to .env and fill in real values.

# App
APP_ENV=development
APP_NAME=conductor-backend
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Security
JWT_SECRET_KEY=change-me-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=postgresql+psycopg://conductor:conductor@localhost:5432/conductor

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant (vector store)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=conductor_documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Object storage (S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_DOCUMENTS=conductor-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# LLM serving
VLLM_BASE_URL=http://localhost:8000
VLLM_API_KEY=EMPTY
MODEL_ID=conductor/mistral-7b-instruct-v0.3-conductor
FALLBACK_MODEL_ID=gpt-4o-mini
MODEL_ROUTING_MAX_COST=0.01
ENABLE_CRITIC=false

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Ingestion
MAX_DOCUMENT_SIZE_MB=50
SUPPORTED_DOC_TYPES=["pdf","docx","txt","md","csv"]
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64