# Conductor fine-tuning environment (copy to .env and fill in).

BASE_MODEL=HuggingFaceH4/zephyr-7b-beta
BASE_MODEL_FALLBACK=mistralai/Mistral-7B-Instruct-v0.3

# Dataset
DATA_DIR=./data
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
TRAIN_FILE=./data/processed/train.jsonl
VAL_FILE=./data/processed/val.jsonl

# Training
SEED=42
MAX_SEQ_LEN=2048
PER_DEVICE_TRAIN_BATCH_SIZE=2
GRADIENT_ACCUMULATION_STEPS=8
NUM_EPOCHS=3
LEARNING_RATE=2e-4
LORA_R=32
LORA_ALPHA=64
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# Quantization
QUANT_BITS=4           # NF4 for QLoRA
RELOAD_ON_BITS_AND_BYTES=false

# Eval / serve
EVAL_DIR=./out/eval
OUTPUT_DIR=./out/lora
SAVE_DIR=./out/merged
VLLM_PROMPT_FORMAT=zephyr